# Vibe Coder — Environment Variables
# Copy this to .env and fill in the values.

# Database (required)
DATABASE_URL="postgresql://vibecoder:dev_password_123@localhost:5433/vibecoder_dev"

# Redis (optional, defaults to localhost:6379)
REDIS_URL="redis://localhost:6379"

# Auth (ALL REQUIRED)
# Create a GitHub OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:4000/v1/auth/github/callback
JWT_SECRET="change-me-to-a-random-32-char-string"
JWT_EXPIRES_IN="15m"
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_WEBHOOK_SECRET=""

# Frontend/API URLs
# FRONTEND_URL: comma-separated origins for CORS (first entry is used for
# redirects after OAuth/Stripe — keep it a single valid origin first).
FRONTEND_URL="http://localhost:3000"
# API_URL: public origin of this API. Sent as the GitHub OAuth redirect_uri,
# so it must exactly match the OAuth App's registered callback URL above.
API_URL="http://localhost:4000"
# GITHUB_REDIRECT_URI (optional): pins the full OAuth callback URL, overriding
# the API_URL-derived value. Use it only when the OAuth App's registered
# callback genuinely differs from API_URL (e.g. a renamed Railway domain).
# Must match the OAuth App's callback byte-for-byte.
# GITHUB_REDIRECT_URI="http://localhost:4000/v1/auth/github/callback"

# Python microservices
ANALYSIS_SERVICE_URL="http://localhost:8100"
RETRIEVAL_SERVICE_URL="http://localhost:8200"
GENERATION_SERVICE_URL="http://localhost:8300"
MOCK_INTERVIEW_SERVICE_URL="http://localhost:8400"
CODEGRAPH_SERVICE_URL="http://localhost:8500"

# LLM (optional, uses demo mode when empty)
# Primary provider: NVIDIA NIM (comma-separated for key rotation)
NVIDIA_API_KEYS=""
NVIDIA_CHAT_MODEL="meta/llama-3.1-70b-instruct"
# Fallback node: OpenRouter (free tier) used when every NVIDIA key fails
OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Vector store (optional)
PINECONE_API_KEY=""
PINECONE_INDEX="vibecoder-dev"
OPENSEARCH_URL="http://localhost:9200"

# Billing (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
