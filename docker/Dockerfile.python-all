FROM python:3.13-slim AS base
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY packages/analysis/pyproject.toml /tmp/analysis/
COPY packages/retrieval/pyproject.toml /tmp/retrieval/
COPY packages/generation/pyproject.toml /tmp/generation/
COPY packages/mock-interview/pyproject.toml /tmp/mock-interview/

# Write extraction script to file to avoid Docker parsing issues
RUN printf 'import tomllib\nfor svc in ["analysis","retrieval","generation","mock-interview"]:\n  with open(f"/tmp/{svc}/pyproject.toml","rb") as f:\n    data = tomllib.load(f)\n  deps = data.get("tool",{}).get("poetry",{}).get("dependencies",{})\n  reqs = [f"{k}{v}" for k,v in deps.items() if k!="python"]\n  with open(f"/tmp/{svc}/requirements.txt","w") as out:\n    out.write("\\n".join(reqs) + "\\n")\n  print(f"{svc}: {reqs}")\n' > /tmp/extract_reqs.py && python3 /tmp/extract_reqs.py

RUN cat /tmp/analysis/requirements.txt && cat /tmp/retrieval/requirements.txt

RUN pip install --no-cache-dir \
    -r /tmp/analysis/requirements.txt \
    -r /tmp/retrieval/requirements.txt \
    -r /tmp/generation/requirements.txt \
    -r /tmp/mock-interview/requirements.txt

FROM base AS runner
COPY packages/ ./packages/

ENV PYTHONPATH=/app/packages/shared_python/src:/app/packages/analysis/src:/app/packages/retrieval/src:/app/packages/generation/src:/app/packages/mock-interview/src

COPY docker/start-python-services.sh /start-python-services.sh
RUN chmod +x /start-python-services.sh

EXPOSE 8100 8200 8300 8400

CMD ["/start-python-services.sh"]