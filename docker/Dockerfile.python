FROM python:3.13-slim AS base
WORKDIR /app

# Install system dependencies + Poetry
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir poetry

# Copy pyproject.toml files for dependency installation
COPY packages/analysis/pyproject.toml /tmp/analysis/pyproject.toml
COPY packages/retrieval/pyproject.toml /tmp/retrieval/pyproject.toml
COPY packages/generation/pyproject.toml /tmp/generation/pyproject.toml
COPY packages/mock-interview/pyproject.toml /tmp/mock-interview/pyproject.toml

# Export each service's deps to requirements.txt and install
RUN for svc in analysis retrieval generation mock-interview; do \
      cd /tmp/$svc && poetry export -f requirements.txt --without-hashes -o requirements.txt 2>/dev/null || \
      (python -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); [print(f'{k}{v}') for k,v in d.get('tool',{}).get('poetry',{}).get('dependencies',{}).items() if k!='python']" > requirements.txt); \
    done
RUN pip install --no-cache-dir \
    -r /tmp/analysis/requirements.txt \
    -r /tmp/retrieval/requirements.txt \
    -r /tmp/generation/requirements.txt \
    -r /tmp/mock-interview/requirements.txt

FROM base AS runner
COPY packages/ ./packages/

ARG SERVICE=analysis
ENV SERVICE=${SERVICE}

EXPOSE ${SERVICE_PORT:-8100}

CMD if [ "$SERVICE" = "analysis" ]; then \
      uvicorn analysis.main:app --host 0.0.0.0 --app-dir packages/analysis/src --port 8100; \
    elif [ "$SERVICE" = "retrieval" ]; then \
      uvicorn retrieval.main:app --host 0.0.0.0 --app-dir packages/retrieval/src --port 8200; \
    elif [ "$SERVICE" = "generation" ]; then \
      uvicorn generation.main:app --host 0.0.0.0 --app-dir packages/generation/src --port 8300; \
    elif [ "$SERVICE" = "mock-interview" ]; then \
      uvicorn mock_interview.main:app --host 0.0.0.0 --app-dir packages/mock-interview/src --port 8400; \
    fi
