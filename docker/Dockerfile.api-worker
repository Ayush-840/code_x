# Hosted deployment: combined API + Worker image (chosen topology for Railway,
# PRD-D06). CI (.github/workflows/docker.yml → build-api-worker) pushes this as
# ghcr.io/ayush-840/code_x-api-worker. Migrations run via Railway's
# preDeployCommand (railway/api-worker.json), not in this image's start script.
FROM node:20-alpine AS base
RUN apk add --no-cache git openssl
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
RUN corepack enable && pnpm install --frozen-lockfile --prod=false

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY . .
RUN corepack enable && pnpm --filter @vibe-coder/database exec prisma generate
RUN pnpm --filter @vibe-coder/shared build
RUN pnpm --filter @vibe-coder/api build
RUN pnpm --filter @vibe-coder/worker build
# Pre-download Prisma engines to avoid permission issues at runtime
RUN ./packages/database/node_modules/.bin/prisma migrate deploy --schema packages/database/prisma/schema.prisma 2>/dev/null || true

FROM node:20-alpine AS runner
# git is required at runtime: the worker clones repos via simple-git.
RUN apk add --no-cache git openssl
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 apiuser

COPY --from=builder /app/node_modules ./node_modules
# pnpm workspace layout: each app's direct deps are symlinked from its own
# node_modules into the root .pnpm store, so both levels are required at runtime.
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=builder /app/packages/database ./packages/database
# ^ Copy the whole package: every subpath export in packages/database/package.json
#   (".", "./migrations", "./artifacts") must resolve at runtime. Cherry-picking
#   files (prisma/, generated/, migrations.js) silently dropped artifacts.js, so
#   apps/api and apps/worker crashed at boot with
#   "Cannot find module '@vibe-coder/database/artifacts.js'" and every deploy
#   since 2026-09-25 10:12 failed while the stale previous deployment kept
#   serving with outdated CORS config.
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder --chown=apiuser:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=apiuser:nodejs /app/apps/api/package.json ./apps/api/
COPY --from=builder --chown=apiuser:nodejs /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=apiuser:nodejs /app/apps/worker/package.json ./apps/worker/

# Fix prisma engine permissions before switching user
RUN chmod -R u+w /app/node_modules/.pnpm/@prisma+engines@* 2>/dev/null || true

COPY docker/start-api-worker.sh /start.sh
RUN chmod +x /start.sh
# Boot-time smoke test (see start script — fails the container when a shipped
# subpath export or entrypoint is missing).
COPY scripts/smoke-exports.cjs /app/scripts/smoke-exports.cjs

USER apiuser
EXPOSE 4000
ENTRYPOINT []
CMD ["/start.sh"]